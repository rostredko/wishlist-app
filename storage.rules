rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isReservedDemo(wishlistId) {
      return wishlistId in ['christmas-list', 'christmas-list-ua', 'birthday-list', 'birthday-list-ua',
        'secret-santa-list', 'secret-santa-list-ua', 'wedding-list', 'wedding-list-ua',
        'kids-christmas-list', 'st-nicholas-list-ua'];
    }
    function managesWishlist(wishlistId) {
      return request.auth != null &&
        (request.auth.token.get('isAdmin', false) == true ||
         (!isReservedDemo(wishlistId) && firestore.get(/databases/(default)/documents/wishlists/$(wishlistId)).data.ownerUid == request.auth.uid));
    }
    match /banners/{wishlistId}/{fileName} {
      allow read: if true;
      allow create, update: if managesWishlist(wishlistId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if managesWishlist(wishlistId);
    }
    // Legacy flat objects remain public. Their filenames cannot reliably prove ownership.
    match /banners/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
